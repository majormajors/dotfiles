[user]
	email = majors@majors.email
	name = majors
	signingKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF6nrd0zZZ17VM2hzZugeJA4LCvsSbQ0+EpTpwW9ZRRF majors"
[gpg]
	format = ssh
[push]
	default = simple
[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset %C(cyan)%an%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = dimmed_zebra
[core]
	pager = less
[pager]
	branch = false
[fetch]
	recurseSubmodules = on-demand
[init]
	defaultBranch = trunk
[branch]
	sort = -committerdate
